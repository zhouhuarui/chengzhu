# ===== 文本 LLM（DeepSeek；旧 LLM_* 变量仍可作为兼容回退）=====
TEXT_LLM_PROVIDER=deepseek
TEXT_LLM_API_KEY=
TEXT_LLM_BASE_URL=https://api.deepseek.com
TEXT_LLM_FAST_MODEL=deepseek-v4-flash
TEXT_LLM_REASONING_MODEL=deepseek-v4-pro

# ===== 视觉 LLM（阿里百炼 Qwen-VL；与文本凭证隔离）=====
VISION_LLM_PROVIDER=dashscope
VISION_LLM_API_KEY=
VISION_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_LLM_MODEL=qwen3-vl-plus

# ===== LLM 网络边界 =====
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=1
VISION_MAX_PAGES=8
PIPELINE_TIMEOUT_SECONDS=480
LLM_COST_BUDGET_CNY=2
DEBATE_MAX_DIMENSIONS=4
DEBATE_MAX_CORRECTIONS=2

# 旧部署可继续只配置以下 LLM_* 名称；新部署不要重复配置。
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL_NAME=deepseek-v4-flash
# LLM_MODEL_NAME_ANALYSIS=deepseek-v4-pro
# LLM_VL_MODEL_NAME=qwen3-vl-plus
EMBEDDING_MODEL_NAME=text-embedding-v4

# ===== Neo4j（Docker 内运行；Compose 会覆盖容器内 URI）=====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=chengzhu2026

# ===== 博查搜索（Phase 1 web_search 需要）=====
BOCHA_API_KEY=

# ===== Datayes（默认关闭；填写 Token/仓库路径后再启用）=====
DATAYES_ENABLED=false
DATAYES_PROVIDER_MODE=warehouse_then_api
DATAYES_TOKEN=
DATAYES_DATA_DIR=
DATAYES_BASE_URL=https://api.wmcloud.com/data/v1
DATAYES_TIMEOUT_SECONDS=30
DATAYES_PAGE_SIZE=5000
DATAYES_MAX_RPS=1
DATAYES_MAX_CONCURRENCY=2
DATAYES_LICENSE_MODE=private_derived_only
DATAYES_PUBLIC_EXPORT=false
DATAYES_NETWORK_TESTS=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== 可选 =====
TUSHARE_TOKEN=
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5001

# ===== 编排 =====
COLLECTOR_MAX_PARALLEL=5
ANALYST_MAX_TOOL_CALLS=6
REVIEWER_MAX_ROUNDS=2
TRACKING_CRON_ENABLED=true

# ===== AgentTeams v1.2.0（实时任务默认运行时）=====
# Manager 是 OpenClaw 控制面；Team 内固定为 8 个 QwenPaw Worker。
# Token/密码仅供后端和网关读取，不得写入 Worker 包、Matrix 消息或前端。
AGENTTEAMS_ENABLED=true
AGENTTEAMS_VERSION=v1.2.0
# 可直接填写，也可在执行 competition-up 时从 shell 导出；仅注入服务端和 AgentTeams 运行时。
AGENTTEAMS_LLM_API_KEY=
# AgentTeams 官方单次模型输出上限；它不是 2 元/run 的累计硬预算。
AGENTTEAMS_MODEL_MAX_TOKENS=4096
AGENTTEAMS_CONTROLLER_URL=http://127.0.0.1:8090
AGENTTEAMS_AUTH_TOKEN=
# 二选一：也可把 controller token 放在权限受限的文件中。
AGENTTEAMS_AUTH_TOKEN_FILE=
AGENTTEAMS_MANAGER_NAME=default
AGENTTEAMS_TEAM_NAME=chengzhu-research-team
AGENTTEAMS_MATRIX_URL=http://127.0.0.1:6167
AGENTTEAMS_MATRIX_ACCESS_TOKEN=
AGENTTEAMS_ADMIN_USER=admin
AGENTTEAMS_ADMIN_PASSWORD=
AGENTTEAMS_ELEMENT_URL=http://127.0.0.1:18088
AGENTTEAMS_HTTP_TIMEOUT_SECONDS=10
AGENTTEAMS_MAX_ACTIVE_WORKERS=3
# 已有 Team 默认不重放 manifests；仅在确认无活动 run/Worker 的维护窗口设为 1。
AGENTTEAMS_RECONCILE_MANIFESTS=0

# ===== Chengzhu MCP（只经 Higress 暴露给 Worker）=====
# competition-up 会在容器网络中覆盖 URL；不要把 5002 或 Higress 管理口暴露公网。
AGENTTEAMS_MCP_GATEWAY_TOKEN=
# 推荐 competition-up 使用仅服务端可读文件，不把该令牌注入 Worker。
AGENTTEAMS_MCP_GATEWAY_TOKEN_FILE=
AGENTTEAMS_MCP_PUBLIC_URL=http://chengzhu-mcp.agentteams.io:5002/mcp
AGENTTEAMS_MCP_HOST=0.0.0.0
AGENTTEAMS_MCP_PORT=5002

# 官方 alibabacloud-bailian-image-creator 固定版本的服务端执行目录。
# competition-up 会从锁定 commit 下载并校验，不要手工注入到 Worker。
AGENTTEAMS_BAILIAN_SKILL_ROOT=
AGENTTEAMS_BAILIAN_SKILL_TIMEOUT_SECONDS=65
# 演示专用：每个 Team run 仅第一次视觉调用在上游前注入失败，随后自动恢复。
# 正常开发/生产保持 false；该开关只存在于 Chengzhu 服务端。
AGENTTEAMS_DEMO_VISUAL_FAILURE_ONCE=false

# ===== AgentTeams MinIO 不可变制品 =====
# 本地开发可保持 REQUIRED=false；正式竞赛运行必须填凭证并设为 true。
AGENTTEAMS_FS_ENDPOINT=http://127.0.0.1:9000
AGENTTEAMS_FS_ACCESS_KEY=
AGENTTEAMS_FS_SECRET_KEY=
AGENTTEAMS_FS_BUCKET=agentteams-storage
AGENTTEAMS_ARTIFACT_REQUIRED=false

# ===== OpenTelemetry（标准 OTEL 环境变量）=====
# 默认只保留本地 trace_id/span_id；接入 Collector 时设 DISABLED=false 并填写 endpoint。
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=chengzhu-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp

# ===== 仿真推演 =====
SCENARIO_ENABLED=true
SCENARIO_AGENT_SCALE=30
SCENARIO_MAX_ROUNDS=10

# ===== 前端 =====
VITE_API_BASE_URL=http://localhost:5001
